# Step 03 — Create account roles (HCP), prefix 'alebedev'
# Account: 759945100724  OCM: stage  Date: 2026-10-12
#
# Account roles are account-wide and reusable across clusters (NOT per-cluster).
# --hosted-cp creates the HCP variants (3 roles) rather than the Classic set.
# Requires iam:CreateRole + iam:AttachRolePolicy.
#
# Roles created:
#   alebedev-HCP-ROSA-Installer-Role  <- ROSAInstallerPolicy
#       trusted by arn:aws:iam::644306948063:role/RH-Managed-OpenShift-Installer
#   alebedev-HCP-ROSA-Support-Role    <- ROSASRESupportPolicy
#       trusted by arn:aws:iam::644306948063:role/RH-Technical-Support-11009103
#   alebedev-HCP-ROSA-Worker-Role     <- ROSAWorkerInstancePolicy
#                                        + AmazonEC2ContainerRegistryReadOnly
#       trusted by ec2.amazonaws.com (it is an instance profile role)

## Command

AWS_PROFILE=saml rosa create account-roles --hosted-cp --prefix alebedev --mode auto -y

