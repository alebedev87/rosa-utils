# Step 06 — Create operator roles (HCP), prefix 'alebedev'
# Account: 759945100724  OCM: stage  Date: 2026-10-12
#
# 8 roles, one per in-cluster operator. Each trusts the OIDC provider from
# step 05 via sts:AssumeRoleWithWebIdentity, conditioned on the operator's
# service account `sub`. So these are bound to that specific OIDC config --
# if you recreate the OIDC config you must recreate these too.
#
# HCP needs a different set than Classic (note capa-controller-manager,
# control-plane-operator, kms-provider -- these are HCP-specific).

## Command

AWS_PROFILE=saml rosa create operator-roles --hosted-cp \
  --prefix alebedev \
  --oidc-config-id 2td89f2qnstd6p18r7dmj5d93ufr76gs \
  --installer-role-arn arn:aws:iam::759945100724:role/alebedev-HCP-ROSA-Installer-Role \
  --mode auto -y

