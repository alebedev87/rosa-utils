## Command (real)

AWS_PROFILE=saml rosa create cluster \
  --cluster-name alebedev-test \
  --hosted-cp --sts \
  --role-arn arn:aws:iam::759945100724:role/alebedev-HCP-ROSA-Installer-Role \
  --support-role-arn arn:aws:iam::759945100724:role/alebedev-HCP-ROSA-Support-Role \
  --worker-iam-role arn:aws:iam::759945100724:role/alebedev-HCP-ROSA-Worker-Role \
  --oidc-config-id 2td89f2qnstd6p18r7dmj5d93ufr76gs \
  --operator-roles-prefix alebedev \
  --subnet-ids subnet-068756ab60e11f4d9,subnet-0789a957376724be1 \
  --region us-west-2 \
  --billing-account 759945100724 \
  --machine-cidr 10.0.0.0/16 \
  --replicas 2 --compute-machine-type m5.xlarge \
  -y

